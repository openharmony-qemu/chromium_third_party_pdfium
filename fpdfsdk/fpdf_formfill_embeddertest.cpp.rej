@@ -3353,13 +3353,13 @@ TEST_F(FPDFFormFillTextFormEmbedderTest, SelectAllWithKeyboardShortcut) {
   CheckFocusedFieldText("AB");
   CheckSelection("");
 
   // Select all with the keyboard shortcut.
 #if BUILDFLAG(IS_APPLE)
